generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL") // Örn: "postgresql://johndoe:mypassword@localhost:5432/mydb?schema=public"
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  googleId         String?           @unique
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  decks            Deck[]            // Kullanıcının oluşturduğu desteler
  deckSettings     UserDeckSetting[] // Kullanıcının destelere özel ayarları
  reviews          Review[]          // Kullanıcının kart ilerlemeleri
}

model Deck {
  id               String            @id @default(uuid())
  name             String
  description      String?
  authorId         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  author           User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  cards            Card[]
  userSettings     UserDeckSetting[]
}

model Card {
  id               String            @id @default(uuid())
  deckId           String
  frontText        String
  backText         String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  deck             Deck              @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardTags         CardTag[]
  reviews          Review[]
}

model Tag {
  id               String            @id @default(uuid())
  name             String            @unique
  
  cardTags         CardTag[]
}

model CardTag {
  cardId           String
  tagId            String

  card             Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag              Tag               @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
}

model UserDeckSetting {
  userId           String
  deckId           String
  dailyNewCardLimit Int              @default(20)
  dailyReviewLimit  Int              @default(100)

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck             Deck              @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@id([userId, deckId])
}

model Review {
  id               String            @id @default(uuid())
  userId           String
  cardId           String
  easeFactor       Float             @default(2.5) // SuperMemo varsayılanı
  interval         Int               @default(0)   // Gün cinsinden aralık
  repetitions      Int               @default(0)   // Ardışık bilme sayısı
  nextReviewDate   DateTime
  lastReviewedAt   DateTime          @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  card             Card              @relation(fields: [cardId], references: [id], onDelete: Cascade)

  // Bir kullanıcının bir karta ait sadece bir adet inceleme (ilerleme) durumu olabilir
  @@unique([userId, cardId])
}
